##############################################################
# SmartLinkNet FreeRADIUS — sites-available/default
#
# Single virtual server handling:
#   UDP 1812 — Authentication (Hotspot PAP + PPPoE CHAP/MS-CHAPv2)
#   UDP 1813 — Accounting (Start/Stop/Interim-Update)
#   UDP 3799 — CoA / Disconnect-Message from SmartLinkNet
#
# All auth data read from PostgreSQL views via rlm_sql.
# Accounting written directly to radacct table by rlm_sql.
# Voucher mark-used handled by fn_sync_radpostauth DB trigger.
# No exec blocks — no HTTP calls — pure SQL path.
##############################################################

server default {

  # ── Authentication listener (UDP 1812) ───────────────────
  listen {
    type     = auth
    ipaddr   = *
    port     = 1812
    limit {
      max_connections = 256
      lifetime        = 0
      idle_timeout    = 30
    }
  }

  # ── Accounting listener (UDP 1813) ───────────────────────
  listen {
    type     = acct
    ipaddr   = *
    port     = 1813
    limit {
      max_connections = 256
      lifetime        = 0
      idle_timeout    = 30
    }
  }

  # ── CoA / Disconnect listener (UDP 3799) ─────────────────
  listen {
    type   = coa
    ipaddr = *
    port   = 3799
  }

  # ── Authorize ─────────────────────────────────────────────
  # 1. filter_username  — reject malformed usernames
  # 2. preprocess       — fix NAS-Port, add Stripped-User-Name
  # 3. sql              — load radcheck (credentials) + radreply (attrs)
  #                       + radusergroup → radgroupcheck/radgroupreply
  # 4. Set Auth-Type based on what the NAS sent
  # 5. expiration       — reject if Expiration attribute is past
  # 6. pap              — set Auth-Type PAP if User-Password present
  authorize {
    filter_username
    preprocess

    if (!&User-Name) {
      reject
    }

    sql

    if (!control:Auth-Type) {
      if (&User-Password) {
        update control {
          Auth-Type := "PAP"
        }
      }
      elsif (&CHAP-Password) {
        update control {
          Auth-Type := "CHAP"
        }
      }
      elsif (&MS-CHAP-Challenge) {
        update control {
          Auth-Type := "MS-CHAP"
        }
      }
    }

    expiration
    logintime
    pap
  }

  # ── Authenticate ──────────────────────────────────────────
  # MikroTik Hotspot uses PAP (plaintext password over RADIUS).
  # MikroTik PPPoE uses CHAP or MS-CHAPv2.
  # Cleartext-Password in radcheck supports all three.
  authenticate {
    Auth-Type PAP {
      pap
    }
    Auth-Type CHAP {
      chap
    }
    Auth-Type MS-CHAP {
      mschap
    }
  }

  # ── Pre-accounting ────────────────────────────────────────
  preacct {
    preprocess
    acct_unique
    suffix
    files
  }

  # ── Accounting ────────────────────────────────────────────
  # sql writes Start/Stop/Interim-Update directly to radacct.
  # The fn_sync_radacct trigger then syncs to sessions table.
  # detail writes to /var/log/freeradius/radacct/ for audit.
  accounting {
    detail
    sql
    attr_filter.accounting_response
  }

  # ── Session (simultaneous-use check) ─────────────────────
  session {
    sql
  }

  # ── Post-auth ─────────────────────────────────────────────
  # sql writes to radpostauth.
  # fn_sync_radpostauth trigger handles:
  #   - auth_events insert
  #   - voucher mark-used on Access-Accept
  # No exec block needed — all logic is in the DB trigger.
  post-auth {
    sql

    Post-Auth-Type REJECT {
      sql
      attr_filter.access_reject
    }
  }

  # ── CoA / Disconnect ──────────────────────────────────────
  # recv-coa: called when FreeRADIUS receives a CoA-Request or
  #   Disconnect-Request from SmartLinkNet (via radclient/coa-shim).
  #   We do NOT call sql here — CoA packets are forwarded to the NAS,
  #   not looked up in the DB. The NAS IP is in the packet itself.
  recv-coa {
    # Validate the CoA packet came from a known NAS
    # (FreeRADIUS already checks the shared secret from the nas view)
  }

  send-coa {
    # Nothing to do — FreeRADIUS sends the CoA-ACK/NAK back to radclient
  }
}
